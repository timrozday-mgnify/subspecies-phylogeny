nextflow_process {
    name "Test Process SKA2_SHARD_SPLIT"
    script "../main.nf"
    process "SKA2_SHARD_SPLIT"

    tag "modules"
    tag "ska2"
    tag "ska2/shard_split"
    tag "ska2/build"

    test("split one Bacteroides uniformis SKF into 4 bins") {
        setup {
            run("SKA2_BUILD") {
                script "../../build/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'BU_61' ],
                        file(params.test_data_base + 'BU_61_NT5381.1.fa', checkIfExists: true)
                    ]
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = SKA2_BUILD.out.skf
                input[1] = 4
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.bins.size() == 1 },
                { assert process.out.bins.get(0).get(0).id == 'BU_61' },
                { assert process.out.bins.get(0).get(1).size() == 4 },
                { assert process.out.bins.get(0).get(1).every { path(it).exists() } },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("split one Bacteroides uniformis SKF into 4 bins - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [ id:'BU_61' ], file('stub.skf') ]
                input[1] = 4
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.bins.get(0).get(1).size() == 4 },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }
}

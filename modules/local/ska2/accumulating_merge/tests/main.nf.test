nextflow_process {
    name "Test Process SKA2_ACCUMULATING_MERGE"
    script "../main.nf"
    process "SKA2_ACCUMULATING_MERGE"

    tag "modules"
    tag "ska2"
    tag "ska2/accumulating_merge"
    tag "ska2/build"

    test("three Bacteroides uniformis genomes total=3 batch_size=1 min_freq=0.9 [folds with weed]") {
        // batch_size=1 treats each sample SKF as its own batch, so the fold runs
        // 3 iterations with a per-iteration dynamic weed threshold.
        setup {
            run("SKA2_BUILD", alias: "BUILD_1") {
                script "../../build/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'BU_61' ],
                        file(params.test_data_base + 'BU_61_NT5381.1.fa', checkIfExists: true)
                    ]
                    """
                }
            }
            run("SKA2_BUILD", alias: "BUILD_2") {
                script "../../build/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'BU_909' ],
                        file(params.test_data_base + 'BU_909_NT5401.1.fa', checkIfExists: true)
                    ]
                    """
                }
            }
            run("SKA2_BUILD", alias: "BUILD_3") {
                script "../../build/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'BU_AN67' ],
                        file(params.test_data_base + 'BU_AN67_NT5182.1.fa', checkIfExists: true)
                    ]
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = BUILD_1.out.skf
                    .mix(BUILD_2.out.skf)
                    .mix(BUILD_3.out.skf)
                    .map { meta, skf -> skf }
                    .collect()
                input[1] = 3
                input[2] = 1
                input[3] = 0.9
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.skf.size() == 1 },
                { assert path(process.out.skf.get(0)).exists() },
                { assert path(process.out.skf.get(0)).size() > 0 },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("three Bacteroides uniformis genomes total=3 batch_size=1 min_freq=0 [folds without weed]") {
        setup {
            run("SKA2_BUILD", alias: "BUILD_1") {
                script "../../build/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'BU_61' ],
                        file(params.test_data_base + 'BU_61_NT5381.1.fa', checkIfExists: true)
                    ]
                    """
                }
            }
            run("SKA2_BUILD", alias: "BUILD_2") {
                script "../../build/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'BU_909' ],
                        file(params.test_data_base + 'BU_909_NT5401.1.fa', checkIfExists: true)
                    ]
                    """
                }
            }
            run("SKA2_BUILD", alias: "BUILD_3") {
                script "../../build/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'BU_AN67' ],
                        file(params.test_data_base + 'BU_AN67_NT5182.1.fa', checkIfExists: true)
                    ]
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = BUILD_1.out.skf
                    .mix(BUILD_2.out.skf)
                    .mix(BUILD_3.out.skf)
                    .map { meta, skf -> skf }
                    .collect()
                input[1] = 3
                input[2] = 1
                input[3] = 0.0
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.skf.size() == 1 },
                { assert path(process.out.skf.get(0)).exists() },
                { assert path(process.out.skf.get(0)).size() > 0 }
            )
        }
    }

    test("three Bacteroides uniformis genomes - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ file('stub1.skf'), file('stub2.skf'), file('stub3.skf') ]
                input[1] = 3
                input[2] = 1
                input[3] = 0.9
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }
}

params {
    // Required
    input            = null
    outdir           = './results'

    // Publishing
    publish_dir_mode = 'copy'

    // SKA2
    ska_k              = 31
    ska_align_min_freq = '0.9'  // comma-separated list of --min-freq values for ska align (e.g. '0.5,0.9,1.0')
    skip_phylo         = false  // skip all phylogenetic steps (FastANI, SKA2 build, alignment, Gubbins, IQ-TREE); run genome QC only
    skip_alignment     = false  // skip ska align and all downstream steps; produces only merged SKF + FastANI outputs
    skip_gubbins       = false  // skip Gubbins recombination filtering; IQ-TREE runs on snp-sites output only
    skip_iqtree        = false  // skip IQ-TREE; useful when trialling gubbins parameters before committing to tree inference
    ska_merged_skf     = null   // path to a pre-computed merged.skf; skips build/merge/fastani when set
    ska_delete_samples = null   // path to newline-delimited file of sample names to remove from the merged SKF
    ska_distance       = false  // run ska distance (pairwise SNP distances) on the merged SKF
    ska_lo             = false  // run ska lo (left-out SNP/INDEL detection) on the merged SKF
    ska_lo_reference   = null   // optional reference FASTA for ska lo coordinate anchoring
    ska_map_reference       = null   // reference FASTA for ska map (Gubbins track); auto-selected as FastANI medoid if not set
    ska_map_ref_trusted_only = false  // when true, only genomes with trusted=true in the samplesheet are candidates for auto-selection of the ska map reference
    ska_shard_count          = 20     // number of minimizer bins the sharded merge splits each sample into;
                                      // each bin is merged across samples independently (~1/n of the key
                                      // space per task), bounding peak ska merge memory. Increase for lower
                                      // peak memory at the cost of more (parallel) tasks.
    ska_shard_minimizer_len  = 30     // minimizer (l-mer) length used to assign split k-mers to bins; must be
                                      // <= k-1 (ska_k - 1). Only affects how evenly k-mers spread across bins.
    ska_merge_batch_size     = 100    // (legacy) SKFs per batch for the alternative batched-merge subworkflow;
                                      // unused by the default sharded-merge path.
    ska_merge_min_freq       = 0.0    // per-shard weed threshold override; if > 0, each merged shard is weeded
                                      // to remove positions that cannot meet this frequency in the full cohort
                                      // before the final concatenate. If left at 0.0 and skip_alignment is
                                      // false, it is derived automatically as the minimum value in
                                      // ska_align_min_freq, so the merge never keeps positions no downstream
                                      // branch could use. Set to 0.0 with skip_alignment = true to leave
                                      // merged.skf fully unweeded.

    // Genome QC (CheckM2, CheckM, GUNC, BUSCO, QUAST, MAGpurify)
    // QUAST and MAGpurify (gc-content + tetra-freq) run unconditionally when skip_qc = false.
    // CheckM2, CheckM, GUNC, and BUSCO only run when their database path is set.
    skip_qc          = false   // skip the entire QC section
    checkm2_db       = null    // path to CheckM2 DIAMOND database (.dmnd file)
    checkm_db        = null    // path to CheckM database root directory
    gunc_db          = null    // path to GUNC DIAMOND database (.dmnd file)
    busco_lineage_db = null    // path to pre-downloaded BUSCO lineage datasets directory; when null, BUSCO auto-detects lineage and downloads at runtime (slower, needs internet)
    busco_lineage    = null    // BUSCO lineage name (e.g. 'bacteria_odb10'); null uses auto_prok (auto-detection, tests ~20 lineages)
    magpurify_db     = null    // path to MAGpurify database directory (for phylo-markers; optional)

    // MultiQC
    multiqc_title    = null

    // Resource limits (overridden by HPC/cloud profiles)
    max_cpus         = 16
    max_memory       = '128.GB'
    max_time         = '240.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
}

manifest {
    name            = 'subspecies-phylogeny'
    description     = 'Whole-genome SNP phylogeny of within-species bacterial genomes using SKA2'
    version         = '0.1.0'
    nextflowVersion = '>=25.0'
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
    overwrite = false
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = false
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = false
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${new Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
    overwrite = false
}

nextflow_pipeline {
    name "Test Pipeline SUBSPECIES_PHYLOGENY"
    script "main.nf"

    tag "pipeline"

    test("three B. uniformis genomes") {
        when {
            params {
                input    = "${projectDir}/tests/samplesheets/test.csv"
                outdir   = "$outputDir"
                skip_qc  = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },

                // IQ-TREE produced trees for both gubbins tracks
                { assert path("${params.outdir}/iqtree/no_gubbins/min_freq_0.9/tree.treefile").exists() },
                { assert path("${params.outdir}/iqtree/no_gubbins/min_freq_0.9/tree.treefile").text.contains("BU_61") },
                { assert path("${params.outdir}/iqtree/no_gubbins/min_freq_0.9/tree.treefile").text.contains("BU_909") },
                { assert path("${params.outdir}/iqtree/no_gubbins/min_freq_0.9/tree.treefile").text.contains("BU_AN67") },
                { assert path("${params.outdir}/iqtree/gubbins/min_freq_0.9/tree.treefile").exists() },

                // SKA2 full SNP alignment — 3 sequences
                { assert path("${params.outdir}/ska2/min_freq_0.9/alignment.fasta").exists() },
                { assert path("${params.outdir}/ska2/min_freq_0.9/alignment.fasta")
                    .readLines().count { it.startsWith('>') } == 3 },

                // merged.skf published for reanalysis
                { assert path("${params.outdir}/ska2/merged.skf").exists() },

                // per-sample .skf files published in ska2/skf/
                { assert new File("${params.outdir}/ska2/skf").listFiles()
                    .any { it.name.endsWith('.skf') } },

                // snp-sites variable-sites alignment
                { assert path("${params.outdir}/snpsites/min_freq_0.9/0.9.fas").exists() },

                // FastANI all-vs-all result table (3×3 = 9 rows incl. self-comparisons)
                { assert path("${params.outdir}/fastani/fastani.txt").exists() },
                { assert path("${params.outdir}/fastani/fastani.txt")
                    .readLines().size() == 9 },

                // NJ tree from FastANI distances
                { assert path("${params.outdir}/nj_tree/fastani_nj.nwk").exists() },
                { assert path("${params.outdir}/nj_tree/fastani_nj.nwk").text.contains("BU_61_NT5381.1") },
                { assert path("${params.outdir}/nj_tree/fastani_nj.nwk").text.contains("BU_909_NT5401.1") },
                { assert path("${params.outdir}/nj_tree/fastani_nj.nwk").text.contains("BU_AN67_NT5182.1") },

                // MultiQC report
                { assert path("${params.outdir}/multiqc/multiqc_report.html").exists() }
            )
        }
    }

    test("three B. uniformis genomes - stub") {
        options "-stub"
        when {
            params {
                input   = "${projectDir}/tests/samplesheets/test.csv"
                outdir  = "$outputDir"
                skip_qc = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 3 SKA2_BUILD + 1 SKA2_MERGE_BATCH + 1 SKA2_ACCUMULATING_MERGE + 1 FASTANI + 1 NJ_TREE_FASTANI
                // + 1 SELECT_REFERENCE + 1 SKA2_ALIGN + 1 SNPSITES
                // + 1 SKA2_WEED + 1 SKA2_MAP + 1 GUBBINS + 2 IQTREE
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 17 tasks
                { assert workflow.trace.succeeded().size() == 17 }
            )
        }
    }

    test("three B. uniformis genomes - stub with delete") {
        options "-stub"
        when {
            params {
                input               = "${projectDir}/tests/samplesheets/test.csv"
                outdir              = "$outputDir"
                ska_delete_samples  = "${projectDir}/tests/data/delete_samples.txt"
                skip_qc             = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // same as default stub (17) + 1 SKA2_DELETE = 18 tasks
                { assert workflow.trace.succeeded().size() == 18 }
            )
        }
    }

    test("three B. uniformis genomes - stub with distance") {
        options "-stub"
        when {
            params {
                input         = "${projectDir}/tests/samplesheets/test.csv"
                outdir        = "$outputDir"
                ska_distance  = true
                skip_qc       = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // default stub (17) + 1 SKA2_DISTANCE + 1 NJ_TREE_SKA2 = 19 tasks
                { assert workflow.trace.succeeded().size() == 19 }
            )
        }
    }

    test("three B. uniformis genomes - stub with lo") {
        options "-stub"
        when {
            params {
                input    = "${projectDir}/tests/samplesheets/test.csv"
                outdir   = "$outputDir"
                ska_lo   = true
                skip_qc  = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // same as default stub (17) + 1 SKA2_LO = 18 tasks
                { assert workflow.trace.succeeded().size() == 18 }
            )
        }
    }

    test("resume from merged SKF, no input - stub") {
        options "-stub"
        when {
            params {
                // No input samplesheet — build/merge, FastANI, NJ_TREE_FASTANI and
                // SELECT_REFERENCE are all skipped. With no reference available, the
                // Gubbins track (SKA2_MAP → GUBBINS + its IQTREE) is skipped too;
                // SKA2_WEED still runs as it does not need a reference. A log.warn
                // is emitted pointing the user to --ska_map_reference / --input.
                ska_merged_skf = "${projectDir}/tests/data/dummy_merged.skf"
                outdir         = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 1 SKA2_ALIGN + 1 SNPSITES + 1 SKA2_WEED + 1 IQTREE (no_gubbins only)
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 6 tasks
                { assert workflow.trace.succeeded().size() == 6 }
            )
        }
    }

    test("resume from merged SKF, with input auto-medoid - stub") {
        options "-stub"
        when {
            params {
                // Genomes still supplied via --input: build/merge are skipped (merged
                // SKF is reused), but FASTANI + SELECT_REFERENCE run to auto-select the
                // medoid as the ska map reference, so the full Gubbins track runs.
                // NJ_TREE_FASTANI is not run in merged-SKF mode.
                ska_merged_skf = "${projectDir}/tests/data/dummy_merged.skf"
                input          = "${projectDir}/tests/samplesheets/test.csv"
                outdir         = "$outputDir"
                skip_qc        = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 1 FASTANI + 1 SELECT_REFERENCE + 1 SKA2_ALIGN + 1 SNPSITES
                // + 1 SKA2_WEED + 1 SKA2_MAP + 1 GUBBINS + 2 IQTREE
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 11 tasks
                { assert workflow.trace.succeeded().size() == 11 }
            )
        }
    }

    test("three B. uniformis genomes - stub skip alignment") {
        options "-stub"
        when {
            params {
                input          = "${projectDir}/tests/samplesheets/test.csv"
                outdir         = "$outputDir"
                skip_alignment = true
                skip_qc        = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 3 SKA2_BUILD + 1 SKA2_MERGE_BATCH + 1 SKA2_ACCUMULATING_MERGE + 1 FASTANI + 1 NJ_TREE_FASTANI
                // + 1 SELECT_REFERENCE + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 10 tasks
                // (skip_alignment disables the whole align + Gubbins track)
                { assert workflow.trace.succeeded().size() == 10 }
            )
        }
    }

    test("three B. uniformis genomes - stub skip iqtree") {
        options "-stub"
        when {
            params {
                input       = "${projectDir}/tests/samplesheets/test.csv"
                outdir      = "$outputDir"
                skip_iqtree = true
                skip_qc     = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 3 SKA2_BUILD + 1 SKA2_MERGE_BATCH + 1 SKA2_ACCUMULATING_MERGE + 1 FASTANI + 1 NJ_TREE_FASTANI
                // + 1 SELECT_REFERENCE + 1 SKA2_ALIGN + 1 SNPSITES
                // + 1 SKA2_WEED + 1 SKA2_MAP + 1 GUBBINS
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 15 tasks
                { assert workflow.trace.succeeded().size() == 15 }
            )
        }
    }

    test("three B. uniformis genomes - stub two min-freq values") {
        options "-stub"
        when {
            params {
                input              = "${projectDir}/tests/samplesheets/test.csv"
                outdir             = "$outputDir"
                ska_align_min_freq = "0.5,0.9"
                skip_qc            = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 3 BUILD + 1 MERGE_BATCH + 1 ACCUMULATING_MERGE + 1 FASTANI + 1 NJ_TREE_FASTANI + 1 SELECT_REFERENCE (= 8)
                // + 2 min_freq × (ALIGN + SNPSITES + WEED + MAP + GUBBINS) = 10
                // + 2 min_freq × 2 gubbins tracks × IQTREE = 4
                // + 1 DUMPSOFTWAREVERSIONS + 1 MULTIQC (= 2)
                // = 8 + 10 + 4 + 2 = 24 tasks
                { assert workflow.trace.succeeded().size() == 24 }
            )
        }
    }

    test("three B. uniformis genomes - stub with qc (no databases)") {
        options "-stub"
        when {
            params {
                input   = "${projectDir}/tests/samplesheets/test.csv"
                outdir  = "$outputDir"
                skip_qc = false
                // No db params set — only QUAST + MAGPURIFY + BUSCO_BUSCO run (database-free)
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // default (17 with skip_qc=true) + 3 QUAST + 3 MAGPURIFY + 3 BUSCO_BUSCO = 26 tasks
                { assert workflow.trace.succeeded().size() == 26 }
            )
        }
    }

    test("three B. uniformis genomes - stub qc only") {
        options "-stub"
        when {
            params {
                input       = "${projectDir}/tests/samplesheets/test.csv"
                outdir      = "$outputDir"
                skip_phylo  = true
                // skip_qc defaults to false — QC runs, phylogeny skipped entirely
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 3 QUAST + 3 MAGPURIFY + 3 BUSCO_BUSCO (database-free QC)
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 11 tasks
                { assert workflow.trace.succeeded().size() == 11 }
            )
        }
    }

    test("three B. uniformis genomes - stub with qc (all databases)") {
        options "-stub"
        when {
            params {
                input            = "${projectDir}/tests/samplesheets/test.csv"
                outdir           = "$outputDir"
                skip_qc          = false
                // CheckM2 and CheckM are stub-only (databases require checksums / pplacer)
                gunc_db          = "${projectDir}/tests/databases/mini_gunc.dmnd"
                busco_lineage_db = "${projectDir}/tests/databases/busco_downloads"
                busco_lineage    = "mini_test_odb10"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // default (17) + 3 QUAST + 3 MAGPURIFY + 3 GUNC_RUN + 3 BUSCO_BUSCO = 29 tasks
                // (CheckM2 and CheckM require real databases with checksums/pplacer)
                { assert workflow.trace.succeeded().size() == 29 }
            )
        }
    }
}

nextflow_pipeline {
    name "Test Pipeline SUBSPECIES_PHYLOGENY"
    script "main.nf"

    tag "pipeline"

    test("three B. uniformis genomes") {
        when {
            params {
                input       = "${projectDir}/tests/samplesheets/test.csv"
                outdir      = "$outputDir"
                skip_qc     = true
                run_fastani = true   // exercise the optional FastANI QC outputs
            }
        }
        then {
            assertAll(
                { assert workflow.success },

                // ska map reference auto-selected as the ska2 SNP-distance medoid
                { assert path("${params.outdir}/ska2/map/reference.fa").exists() },

                // IQ-TREE produced trees for both gubbins tracks
                { assert path("${params.outdir}/iqtree/no_gubbins/min_freq_0.9/tree.treefile").exists() },
                { assert path("${params.outdir}/iqtree/no_gubbins/min_freq_0.9/tree.treefile").text.contains("BU_61") },
                { assert path("${params.outdir}/iqtree/no_gubbins/min_freq_0.9/tree.treefile").text.contains("BU_909") },
                { assert path("${params.outdir}/iqtree/no_gubbins/min_freq_0.9/tree.treefile").text.contains("BU_AN67") },
                { assert path("${params.outdir}/iqtree/gubbins/min_freq_0.9/tree.treefile").exists() },

                // SKA2 full SNP alignment — 3 sequences
                { assert path("${params.outdir}/ska2/align/min_freq_0.9/alignment.fasta").exists() },
                { assert path("${params.outdir}/ska2/align/min_freq_0.9/alignment.fasta")
                    .readLines().count { it.startsWith('>') } == 3 },

                // merged.skf published for reanalysis; per-sample SKFs are not published
                { assert path("${params.outdir}/ska2/merge/merged.skf").exists() },
                { assert !path("${params.outdir}/ska2/skf").exists() },

                // snp-sites variable-sites alignment
                { assert path("${params.outdir}/snpsites/min_freq_0.9/0.9.fas").exists() },

                // FastANI all-vs-all result table (3×3 = 9 rows incl. self-comparisons)
                { assert path("${params.outdir}/fastani/fastani.txt").exists() },
                { assert path("${params.outdir}/fastani/fastani.txt")
                    .readLines().size() == 9 },

                // NJ tree from FastANI distances
                { assert path("${params.outdir}/nj_tree/fastani_nj.nwk").exists() },
                { assert path("${params.outdir}/nj_tree/fastani_nj.nwk").text.contains("BU_61_NT5381.1") },
                { assert path("${params.outdir}/nj_tree/fastani_nj.nwk").text.contains("BU_909_NT5401.1") },
                { assert path("${params.outdir}/nj_tree/fastani_nj.nwk").text.contains("BU_AN67_NT5182.1") },

                // MultiQC report
                { assert path("${params.outdir}/multiqc/multiqc_report.html").exists() }
            )
        }
    }

    test("three B. uniformis genomes - stub") {
        options "-stub"
        when {
            params {
                input   = "${projectDir}/tests/samplesheets/test.csv"
                outdir  = "$outputDir"
                skip_qc = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // ska_shard_count=4 (tests/nextflow.config); merge_min_freq=0.9 so shards are weeded.
                // FastANI is off by default; the reference is the ska2-distance medoid.
                // 3 SKA2_BUILD + 3 SKA2_SHARD_SPLIT + 4 SKA2_MERGE_SHARD + 4 SKA2_WEED_SHARD + 1 SKA2_SHARD_CONCAT
                // + 1 SKA2_DISTANCE + 1 SELECT_REFERENCE
                // + 1 SKA2_ALIGN + 1 SNPSITES
                // + 1 SKA2_WEED + 1 SKA2_MAP + 1 GUBBINS + 2 IQTREE
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 26 tasks
                { assert workflow.trace.succeeded().size() == 26 }
            )
        }
    }

    test("three B. uniformis genomes - stub with gubbins subset") {
        options "-stub"
        when {
            params {
                input                          = "${projectDir}/tests/samplesheets/test.csv"
                outdir                         = "$outputDir"
                skip_qc                        = true
                ska_gubbins_subset             = true
                ska_gubbins_subset_target_snps = 1000
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // default stub (26) + 1 SKA2_SUBSET for the single min_freq branch = 27 tasks
                { assert workflow.trace.succeeded().size() == 27 }
            )
        }
    }

    test("three B. uniformis genomes - stub with delete") {
        options "-stub"
        when {
            params {
                input               = "${projectDir}/tests/samplesheets/test.csv"
                outdir              = "$outputDir"
                ska_delete_samples  = "${projectDir}/tests/data/delete_samples.txt"
                skip_qc             = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // same as default stub (26) + 1 SKA2_DELETE = 27 tasks
                { assert workflow.trace.succeeded().size() == 27 }
            )
        }
    }

    test("three B. uniformis genomes - stub with distance") {
        options "-stub"
        when {
            params {
                input         = "${projectDir}/tests/samplesheets/test.csv"
                outdir        = "$outputDir"
                ska_distance  = true
                skip_qc       = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // SKA2_DISTANCE already runs for the reference; --ska_distance only adds the NJ tree.
                // default stub (26) + 1 NJ_TREE_SKA2 = 27 tasks
                { assert workflow.trace.succeeded().size() == 27 }
            )
        }
    }

    test("three B. uniformis genomes - stub with lo") {
        options "-stub"
        when {
            params {
                input    = "${projectDir}/tests/samplesheets/test.csv"
                outdir   = "$outputDir"
                ska_lo   = true
                skip_qc  = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // same as default stub (26) + 1 SKA2_LO = 27 tasks
                { assert workflow.trace.succeeded().size() == 27 }
            )
        }
    }

    test("resume from merged SKF, no input - stub") {
        options "-stub"
        when {
            params {
                // No input samplesheet — build/merge and SELECT_REFERENCE are skipped
                // (SKA2_DISTANCE for the reference needs --input to emit a FASTA from).
                // With no reference available, the Gubbins track (SKA2_MAP → GUBBINS +
                // its IQTREE) is skipped too; SKA2_WEED still runs as it does not need a
                // reference. A log.warn points the user to --ska_map_reference / --input.
                ska_merged_skf = "${projectDir}/tests/data/dummy_merged.skf"
                outdir         = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 1 SKA2_ALIGN + 1 SNPSITES + 1 SKA2_WEED + 1 IQTREE (no_gubbins only)
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 6 tasks
                { assert workflow.trace.succeeded().size() == 6 }
            )
        }
    }

    test("resume from merged SKF, with input auto-medoid - stub") {
        options "-stub"
        when {
            params {
                // Genomes still supplied via --input: build/merge are skipped (merged
                // SKF is reused), but SKA2_DISTANCE + SELECT_REFERENCE run to auto-select
                // the ska2-distance medoid as the ska map reference, so the full Gubbins
                // track runs. FastANI is off by default.
                ska_merged_skf = "${projectDir}/tests/data/dummy_merged.skf"
                input          = "${projectDir}/tests/samplesheets/test.csv"
                outdir         = "$outputDir"
                skip_qc        = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 1 SKA2_DISTANCE + 1 SELECT_REFERENCE + 1 SKA2_ALIGN + 1 SNPSITES
                // + 1 SKA2_WEED + 1 SKA2_MAP + 1 GUBBINS + 2 IQTREE
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 11 tasks
                { assert workflow.trace.succeeded().size() == 11 }
            )
        }
    }

    test("three B. uniformis genomes - stub skip alignment") {
        options "-stub"
        when {
            params {
                input          = "${projectDir}/tests/samplesheets/test.csv"
                outdir         = "$outputDir"
                skip_alignment = true
                skip_qc        = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // skip_alignment ⇒ merge_min_freq stays 0 (no weed) AND the Gubbins track
                // is inactive, so no reference is selected (no SKA2_DISTANCE/SELECT_REFERENCE);
                // FastANI is off by default:
                // 3 SKA2_BUILD + 3 SKA2_SHARD_SPLIT + 4 SKA2_MERGE_SHARD + 1 SKA2_SHARD_CONCAT
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 13 tasks
                { assert workflow.trace.succeeded().size() == 13 }
            )
        }
    }

    test("three B. uniformis genomes - stub skip iqtree") {
        options "-stub"
        when {
            params {
                input       = "${projectDir}/tests/samplesheets/test.csv"
                outdir      = "$outputDir"
                skip_iqtree = true
                skip_qc     = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 3 SKA2_BUILD + 3 SKA2_SHARD_SPLIT + 4 SKA2_MERGE_SHARD + 4 SKA2_WEED_SHARD + 1 SKA2_SHARD_CONCAT
                // + 1 SKA2_DISTANCE + 1 SELECT_REFERENCE
                // + 1 SKA2_ALIGN + 1 SNPSITES
                // + 1 SKA2_WEED + 1 SKA2_MAP + 1 GUBBINS
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 24 tasks
                { assert workflow.trace.succeeded().size() == 24 }
            )
        }
    }

    test("three B. uniformis genomes - stub two min-freq values") {
        options "-stub"
        when {
            params {
                input              = "${projectDir}/tests/samplesheets/test.csv"
                outdir             = "$outputDir"
                ska_align_min_freq = "0.5,0.9"
                skip_qc            = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // merge_min_freq = min(0.5, 0.9) = 0.5 > 0, so shards are weeded:
                // 3 BUILD + 3 SHARD_SPLIT + 4 MERGE_SHARD + 4 WEED_SHARD + 1 SHARD_CONCAT
                // + 1 SKA2_DISTANCE + 1 SELECT_REFERENCE (= 17)
                // + 2 min_freq × (ALIGN + SNPSITES + WEED + MAP + GUBBINS) = 10
                // + 2 min_freq × 2 gubbins tracks × IQTREE = 4
                // + 1 DUMPSOFTWAREVERSIONS + 1 MULTIQC (= 2)
                // = 17 + 10 + 4 + 2 = 33 tasks
                { assert workflow.trace.succeeded().size() == 33 }
            )
        }
    }

    test("three B. uniformis genomes - stub two min-freq values with gubbins subset") {
        options "-stub"
        when {
            params {
                input                          = "${projectDir}/tests/samplesheets/test.csv"
                outdir                         = "$outputDir"
                ska_align_min_freq             = "0.5,0.9"
                ska_gubbins_subset             = true
                ska_gubbins_subset_target_snps = 1000
                skip_qc                        = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // two-min_freq stub (33) + 2 SKA2_SUBSET tasks = 35 tasks
                { assert workflow.trace.succeeded().size() == 35 }
            )
        }
    }

    test("three B. uniformis genomes - stub with qc (no databases)") {
        options "-stub"
        when {
            params {
                input   = "${projectDir}/tests/samplesheets/test.csv"
                outdir  = "$outputDir"
                skip_qc = false
                // No db params set — only QUAST + MAGPURIFY + BUSCO_BUSCO run (database-free)
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // default (26 with skip_qc=true) + 3 QUAST + 3 MAGPURIFY + 3 BUSCO_BUSCO = 35 tasks
                { assert workflow.trace.succeeded().size() == 35 }
            )
        }
    }

    test("three B. uniformis genomes - stub qc only") {
        options "-stub"
        when {
            params {
                input       = "${projectDir}/tests/samplesheets/test.csv"
                outdir      = "$outputDir"
                skip_phylo  = true
                // skip_qc defaults to false — QC runs, phylogeny skipped entirely
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 3 QUAST + 3 MAGPURIFY + 3 BUSCO_BUSCO (database-free QC)
                // + 1 CUSTOM_DUMPSOFTWAREVERSIONS + 1 MULTIQC = 11 tasks
                { assert workflow.trace.succeeded().size() == 11 }
            )
        }
    }

    test("three B. uniformis genomes - stub with qc (all databases)") {
        options "-stub"
        when {
            params {
                input            = "${projectDir}/tests/samplesheets/test.csv"
                outdir           = "$outputDir"
                skip_qc          = false
                // CheckM2 and CheckM are stub-only (databases require checksums / pplacer)
                gunc_db          = "${projectDir}/tests/databases/mini_gunc.dmnd"
                busco_lineage_db = "${projectDir}/tests/databases/busco_downloads"
                busco_lineage    = "mini_test_odb10"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // default (26) + 3 QUAST + 3 MAGPURIFY + 3 GUNC_RUN + 3 BUSCO_BUSCO = 38 tasks
                // (CheckM2 and CheckM require real databases with checksums/pplacer)
                { assert workflow.trace.succeeded().size() == 38 }
            )
        }
    }
}

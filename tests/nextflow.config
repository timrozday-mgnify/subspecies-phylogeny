docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']
}

params {
    test_data_base = "${projectDir}/tests/data/"
    test_db_base   = "${projectDir}/tests/databases/"

    // Keep the sharded merge small in tests (production default is 20). With the
    // 3-genome fixtures this bounds the per-bin merge/weed task fan-out.
    ska_shard_count = 4
}

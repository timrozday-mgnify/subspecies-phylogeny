    test("three Bacteroides uniformis genomes sharded into 4 bins - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('stub1.skf'),
                    file('stub2.skf'),
                    file('stub3.skf')
                )
                input[1] = 4
                input[2] = 9
                input[3] = 0.0
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("three Bacteroides uniformis genomes sharded into 4 bins min_freq=0.9 - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('stub1.skf'),
                    file('stub2.skf'),
                    file('stub3.skf')
                )
                input[1] = 4
                input[2] = 9
                input[3] = 0.9
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }
}

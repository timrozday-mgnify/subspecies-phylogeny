// Default: don't publish anything (modules must opt in explicitly below)
process {
    publishDir = [ enabled: false ]

    // -----------------------------------------------------------------------
    // Genome QC
    // -----------------------------------------------------------------------

    withName: 'QUAST' {
        // Publish the results directory but not the gzipped TSV copy (the
        // Quarto report reads report.tsv from inside the results directory).
        publishDir = [
            path: { "${params.outdir}/qc/quast/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> (fn.equals('versions.yml') || fn.endsWith('.tsv.gz')) ? null : fn }
        ]
    }

    withName: 'MAGPURIFY' {
        // Only publish the flagged_contigs files; suppress the full output
        // directory (which contains large intermediate gene/HMM files not
        // read by any report).
        publishDir = [
            path: { "${params.outdir}/qc/magpurify" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                if (fn.equals('versions.yml')) return null
                // fn for the results directory emit: '<sample>_magpurify'
                // fn for individual file emits:     '<sample>_magpurify/<module>/flagged_contigs'
                fn.contains('flagged_contigs') ? fn : null
            }
        ]
    }

    withName: 'CHECKM2_PREDICT' {
        // Publish only the per-sample TSV report; the full output directory
        // contains DIAMOND intermediate files not read by any report.
        publishDir = [
            path: { "${params.outdir}/qc/checkm2/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                if (fn.equals('versions.yml')) return null
                fn.endsWith('_checkm2_report.tsv') ? fn : null
            }
        ]
    }

    withName: 'CHECKM' {
        // Publish only the QA TSV; the full CheckM output directory contains
        // HMM, gene, and pplacer intermediate files not read by any report.
        publishDir = [
            path: { "${params.outdir}/qc/checkm/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                if (fn.equals('versions.yml')) return null
                fn.endsWith('_checkm_qa.tsv') ? fn : null
            }
        ]
    }

    withName: 'GUNC_RUN' {
        // Publish the maxCSS-level TSV; suppress the all-levels TSV (not read
        // by any report).
        publishDir = [
            path: { "${params.outdir}/qc/gunc/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                if (fn.equals('versions.yml')) return null
                fn.contains('all_levels') ? null : fn
            }
        ]
    }

    withName: 'BUSCO_BUSCO' {
        // Publish only the batch summary and short summary files; suppress the
        // full *-busco/ output directory (large intermediate files).
        publishDir = [
            path: { "${params.outdir}/qc/busco/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                if (fn.equals('versions.yml'))           return null
                if (fn.startsWith('short_summary'))      return fn   // short_summary.specific/generic.*.txt
                if (fn.endsWith('.batch_summary.txt'))   return fn   // batch summary (batch mode)
                return null                                           // suppress *-busco/ directory
            }
        ]
    }

    // -----------------------------------------------------------------------

    withName: 'NJ_TREE_FASTANI' {
        ext.args   = '--format fastani'
        ext.prefix = 'fastani_nj'
        // Publish the Newick tree (read by stage2 report); suppress the PDF.
        publishDir = [
            path: { "${params.outdir}/nj_tree" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> (fn.equals('versions.yml') || fn.endsWith('.pdf')) ? null : fn }
        ]
    }

    withName: 'NJ_TREE_SKA2' {
        ext.args   = '--format ska2'
        ext.prefix = 'ska2_distance_nj'
        // Publish the Newick tree; suppress the PDF.
        publishDir = [
            path: { "${params.outdir}/nj_tree" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> (fn.equals('versions.yml') || fn.endsWith('.pdf')) ? null : fn }
        ]
    }

    withName: 'FASTANI_ALLVSALL' {
        publishDir = [
            path: { "${params.outdir}/fastani" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'SKA2_BUILD' {
        // k-mer size passed explicitly so it appears in pipeline provenance
        ext.args = { "-k ${params.ska_k}" }
        publishDir = [ enabled: false ]
    }

    withName: 'SKA2_DELETE' {
        ext.prefix = 'merged_deleted'
        publishDir = [
            path: { "${params.outdir}/ska2" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'SKA2_DISTANCE' {
        ext.prefix = 'distances'
        publishDir = [
            path: { "${params.outdir}/ska2" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'SKA2_LO' {
        ext.prefix = 'lo_output'
        publishDir = [
            path: { "${params.outdir}/ska2" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'SELECT_REFERENCE' {
        publishDir = [
            path: { "${params.outdir}/ska2/map" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'SKA2_WEED' {
        ext.args   = { "--min-freq ${meta.min_freq}" }
        ext.prefix = { "weeded_${meta.min_freq}" }
        publishDir = [ enabled: false ]
    }

    withName: 'SKA2_SUBSET' {
        ext.prefix = { "subset_${meta.min_freq}" }
        publishDir = [
            path: { "${params.outdir}/ska2/subset/min_freq_${meta.min_freq}" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                if (fn.equals('versions.yml')) return null
                fn.endsWith('.skf') ? null : fn
            }
        ]
    }

    withName: 'SKA2_SHARD_SPLIT' {
        // Per-sample minimizer split inside SKA2_SHARDED_MERGE. Loads a single
        // sample's SKF and writes n_shards bins — memory is bounded by one sample.
        ext.args = ''
        publishDir = [ enabled: false ]
    }

    withName: 'SKA2_MERGE_SHARD' {
        // Per-bin merge across samples inside SKA2_SHARDED_MERGE. Each task merges
        // only ~1/n_shards of the key space, so peak memory is well below a full
        // cohort merge. Intermediate outputs are not published.
        ext.args = ''
        publishDir = [ enabled: false ]
    }

    withName: 'SKA2_WEED_SHARD' {
        // Exact weed of each merged bin at the final min_freq before concat
        // (the merged bin already holds every sample's column). Not published.
        ext.prefix = { "shard_weeded" }
        publishDir = [ enabled: false ]
    }

    withName: 'SKA2_SHARD_CONCAT' {
        // Concatenate the merged bins into the published merged.skf
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/ska2/merge" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'SKA2_MAP' {
        // The ska map alignment (.aln) is consumed internally by Gubbins and
        // is not read by any Quarto report.  Suppress to avoid publishing
        // ~14 MB per min_freq branch.
        publishDir = [ enabled: false ]
    }

    withName: 'SKA2_ALIGN' {
        ext.args   = { "--min-freq ${meta.min_freq}" }
        publishDir = [
            path: { "${params.outdir}/ska2/align/min_freq_${meta.min_freq}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'SNPSITES' {
        publishDir = [
            path: { "${params.outdir}/snpsites/min_freq_${meta.min_freq}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'GUBBINS' {
        // fasttree: lower memory footprint than iqtree-fast.
        // GTRGAMMA is used explicitly because fasttree does not support GTR
        // (Gubbins' default model); compatible options are JC, GTRCAT, GTRGAMMA.
        // --model-fitter is intentionally not set: Gubbins defaults to the same
        // tool as --tree-builder ("same as tree builder if possible"), so fasttree
        // handles model fitting too. This avoids the separate iqtree -n 0 --mlrate
        // call on the snp-sites alignment; with large MAG cohorts, some assemblies
        // are entirely gap/N in that alignment, IQ-TREE silently drops them, and
        // the resulting treefile has fewer leaves → "Bipartitions missing when
        // harmonising roots" error. If you override --tree-builder to iqtree on
        // your HPC, add --model-fitter raxml to avoid the same issue.
        // Override tree-builder and model in a stage-specific modules.config.
        ext.args   = '--tree-builder fasttree --model GTRGAMMA --filter-percentage 100'
        // Start below process_medium's 6×attempt so task.cpus matches actual
        // usage after the nproc cap in the script (avoids idle allocated CPUs).
        cpus       = { Math.min(task.attempt * 4, params.max_cpus as int) }
        // Publish files read by the Quarto reports and the filtered alignment
        // (useful for downstream analysis).  Suppress: PHYLIP format (redundant
        // with FASTA), node-labelled tree (reports use the plain final_tree.tre),
        // and the VCF SNP distribution (not read by any report).
        publishDir = [
            path: { "${params.outdir}/gubbins/min_freq_${meta.min_freq}" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                if (fn.equals('versions.yml'))     return null
                if (fn.endsWith('.phylip'))         return null
                if (fn.contains('node_labelled'))   return null
                if (fn.endsWith('.vcf'))            return null
                return fn
            }
        ]
    }

    withName: 'IQTREE' {
        // Ascertainment bias correction: -fconst informs IQ-TREE of constant sites
        // stripped by snp-sites so branch lengths are correctly estimated.
        // When Gubbins is used, constant_sites is absent from meta (Gubbins already
        // strips variable sites) so the correction is omitted.
        ext.args   = { meta.constant_sites ? "-fconst ${meta.constant_sites}" : '' }
        ext.prefix = 'tree'
        publishDir = [
            path: { "${params.outdir}/iqtree/${meta.gubbins}/min_freq_${meta.min_freq}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        // Publish only the HTML report; suppress the multiqc_data/ directory
        // (not read by any Quarto report).
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                if (fn.equals('versions.yml')) return null
                fn.contains('multiqc_data') ? null : fn
            }
        ]
    }
}

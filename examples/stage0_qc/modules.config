// Stage 0 — optional QC tool argument overrides
//
// This file is only needed if you want to change tool defaults.
// Most stage 0 runs work fine with no custom modules.config.
//
// Pass with: nextflow run main.nf -profile docker \
//                                 -params-file examples/stage0_qc/params.yml \
//                                 -c examples/stage0_qc/modules.config

process {
    // -----------------------------------------------------------------------
    // QUAST — assembly statistics
    // Default: runs metaquast.py with no reference (reference-free mode).
    // -----------------------------------------------------------------------
    // withName: 'QUAST' {
    //     ext.args = '--min-contig 500'   // ignore contigs shorter than 500 bp
    // }

    // -----------------------------------------------------------------------
    // MAGpurify — per-contig GC-content and tetranucleotide-frequency checks
    // No standard arguments are typically needed.
    // -----------------------------------------------------------------------

    // -----------------------------------------------------------------------
    // CheckM2 — ML-based completeness and contamination
    // -----------------------------------------------------------------------
    // withName: 'CHECKM2_PREDICT' {
    //     ext.args = '--lowmem'   // reduce memory usage at the cost of speed
    // }

    // -----------------------------------------------------------------------
    // CheckM v1 — HMM-based completeness and contamination (legacy)
    // -----------------------------------------------------------------------
    // withName: 'CHECKM' {
    //     ext.args = '--reduced_tree'  // use reduced reference tree (faster)
    // }

    // -----------------------------------------------------------------------
    // GUNC — chimeric genome detection
    // -----------------------------------------------------------------------
    // withName: 'GUNC_RUN' {
    //     ext.args = '--detailed_output'   // write per-level TSV alongside maxCSS
    // }

    // -----------------------------------------------------------------------
    // BUSCO — lineage-specific single-copy ortholog completeness
    // The lineage is set via --busco_lineage in params.yml.
    // -----------------------------------------------------------------------
    // withName: 'BUSCO_BUSCO' {
    //     ext.args = '--augustus'   // use AUGUSTUS for eukaryotic gene prediction
    // }
}

// Stage 1 — Explore: optional tool-argument overrides
//
// This file is only needed if you want to change tool defaults.
// Most stage 1 runs work fine without a custom modules.config.
//
// Pass with: nextflow run main.nf -profile docker \
//                                 -params-file examples/stage1_explore/params.yml \
//                                 -c examples/stage1_explore/modules.config

process {
    // -----------------------------------------------------------------------
    // QUAST — assembly statistics (no reference, reference-free mode)
    // -----------------------------------------------------------------------
    // withName: 'QUAST' {
    //     ext.args = '--min-contig 500'   // ignore contigs shorter than 500 bp
    // }

    // -----------------------------------------------------------------------
    // CheckM2 — ML-based completeness and contamination
    // -----------------------------------------------------------------------
    // withName: 'CHECKM2_PREDICT' {
    //     ext.args = '--lowmem'   // reduce memory usage at the cost of speed
    // }

    // -----------------------------------------------------------------------
    // CheckM v1 — HMM-based completeness and contamination (legacy)
    // -----------------------------------------------------------------------
    // withName: 'CHECKM' {
    //     ext.args = '--reduced_tree'  // use the reduced reference tree (faster)
    // }

    // -----------------------------------------------------------------------
    // GUNC — chimeric genome detection
    // -----------------------------------------------------------------------
    // withName: 'GUNC_RUN' {
    //     ext.args = '--detailed_output'   // write per-level TSV alongside maxCSS
    // }

    // -----------------------------------------------------------------------
    // SKA2_ALIGN — alignment filter
    // --filter no-filter includes all positions regardless of how many samples
    // have a called base.  The pipeline always injects --min-freq; only add
    // extra flags here.
    // -----------------------------------------------------------------------
    withName: 'SKA2_ALIGN' {
        ext.args = { "--min-freq ${meta.min_freq} --filter no-filter" }
    }

    // -----------------------------------------------------------------------
    // Gubbins — recombination detection
    //
    // For exploration, fasttree is fast and robust.  Switch to 'iqtree' in
    // examples/stage2_build/modules.config for the final production tree.
    //
    // Key arguments:
    //   --tree-builder  fasttree | iqtree | raxmlng | rapidnj
    //   --model         GTR (no gamma; stable on near-clonal data) | GTRGAMMA
    //   --iterations    typically 5; more iterations refine boundaries
    //   --min-snps      minimum SNPs to call a recombination event; increase
    //                   (e.g. 10) to reduce false positives in very similar genomes
    //   --min-window-size  minimum block length (bp)
    //   --filter-percentage  drop samples with > pct% of bases masked
    // -----------------------------------------------------------------------
    withName: 'GUBBINS' {
        ext.args = [
            '--tree-builder fasttree',
            '--model GTR',
            '--iterations 5',
            '--min-snps 3',
            '--min-window-size 100',
            '--filter-percentage 100',
        ].join(' ')
    }
}

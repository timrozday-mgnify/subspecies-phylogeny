// Stage 2 — Build: tool-argument overrides for the final phylogeny
//
// Copy and adjust the Gubbins settings that worked well in stage 1, then
// set IQ-TREE model and bootstrap parameters for the final trees.
//
// Pass with: nextflow run main.nf -profile docker \
//                                 -params-file examples/stage2_build/params.yml \
//                                 -c examples/stage2_build/modules.config

process {
    withName: 'SKA2_ALIGN' {
        ext.args = { "--min-freq ${meta.min_freq} --filter no-filter" }
    }

    // -----------------------------------------------------------------------
    // Gubbins — copy or refine the settings from stage 1
    //
    // For a production tree, use 'iqtree' instead of 'fasttree'.
    // See examples/stage1_explore/modules.config for argument descriptions.
    // -----------------------------------------------------------------------
    withName: 'GUBBINS' {
        ext.args = [
            '--tree-builder iqtree',
            '--model GTR',
            '--iterations 5',
            '--min-snps 3',
            '--min-window-size 100',
            '--filter-percentage 100',
        ].join(' ')
    }

    // -----------------------------------------------------------------------
    // IQ-TREE — maximum-likelihood phylogeny
    //
    // Key arguments:
    //   -fconst A,C,G,T
    //     Constant-site counts for ascertainment-bias correction on the
    //     no_gubbins track.  Always preserve the meta.constant_sites expression
    //     below — the pipeline injects it automatically.
    //   -m <model>
    //     Substitution model.
    //     GTR+G      general time-reversible + gamma rates (reliable default)
    //     MFP        ModelFinder selects the best model (slowest)
    //     Note: do NOT add +ASC on the no_gubbins track — the pipeline already
    //     corrects for constant sites via -fconst.
    //   -B <n>
    //     Ultrafast bootstrap replicates. 1000 is standard.
    //   -b <n>
    //     Standard (non-parametric) bootstrap. Much slower than -B.
    //   --seed <n>
    //     Random seed for reproducibility.
    // -----------------------------------------------------------------------
    withName: 'IQTREE' {
        ext.args = {
            [
                meta.constant_sites ? "-fconst ${meta.constant_sites}" : '',
                '-m GTR+G',
                '-B 1000',
                '--seed 42',
            ].findAll { it }.join(' ')
        }
    }
}
